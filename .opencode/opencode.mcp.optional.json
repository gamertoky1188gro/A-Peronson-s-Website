{
	"$schema": "https://opencode.ai/config.json",
	"mcp": {
		"servers": {
			"context7": {
				"type": "remote",
				"url": "https://mcp.context7.com/mcp",
				"oauth": false,
				"codemode": false,
				"timeout": 30000,
				"headers": {
					"CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
				}
			}
		}
	}
}
