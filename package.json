		"@syenchuk/remark-abbr": "^1.0.1",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.2.0",
		"@vitejs/plugin-react": "^5.1.1",
		"ansi-escapes": "^7.3.0",
		"axios": "^1.13.6",
		"bcryptjs": "^3.0.3",
		"blessed": "npm:neo-blessed@^0.2.0",
		"blessed-contrib": "^4.11.0",
		"chalk": "^5.6.2",
		"cli-highlight": "^2.1.11",
		"concurrently": "^9.0.1",
		"cors": "^2.8.6",
		"dompurify": "^3.4.12",
		"express": "^5.2.1",
		"express-rate-limit": "8.5.2",
		"framer-motion": "^12.36.0",
		"googleapis": "^133.0.0",
		"gradient-string": "^3.0.0",
		"helmet": "^8.1.0",
		"json-colorizer": "^3.0.1",
		"jsonwebtoken": "^9.0.3",
		"leaflet": "^1.9.4",
		"lenis": "^1.3.23",
		"link-preview-js": "^4.0.3",
		"lucide-react": "^0.575.0",
		"multer": "^2.1.0",
		"neo-blessed": "^0.2.0",
		"nodemailer": "^6.10.1",
		"opencode-ai": "^1.15.5",
		"pdfjs-dist": "^5.5.207",
		"pdfkit": "^0.18.0",
		"prismjs": "^1.30.0",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"react-loading-indicators": "^1.0.1",
		"react-markdown": "^10.1.0",
		"react-password-checklist": "^1.8.1",
		"react-password-strength-bar": "^0.4.1",
		"react-redux": "^9.3.0",
		"react-router-dom": "^7.13.0",
		"react-syntax-highlighter": "^16.1.1",
		"react-window": "^2.2.7",
		"recharts": "^2.12.7",
		"redis": "^4.7.1",
		"redux-logger": "^3.0.6",
		"rehype-raw": "^7.0.0",
		"rehype-sanitize": "^6.0.0",
		"remark-deflist": "^1.0.0",
		"remark-directive": "^4.0.0",
		"remark-emoji": "^5.0.2",
		"remark-gfm": "^4.0.1",
		"remark-highlight-mark": "^1.4.0",
		"remark-ins": "^1.2.3",
		"remark-smartypants": "^3.0.2",
		"remark-supersub": "^1.0.0",
		"rtf.js": "^3.0.9",
		"sharp": "^0.35.2",
		"tailwindcss": "^4.2.0",
		"tar": "^7.5.9",
		"unzipper": "^0.12.3",
		"ws": "^8.19.0",
		"xlsx": "^0.18.5"
	},
	"devDependencies": {
		"@babel/core": "^7.26.0",
		"@babel/preset-env": "^7.26.0",
		"@babel/preset-react": "^7.25.9",
		"@biomejs/biome": "^2.5.5",
		"@playwright/test": "^1.49.1",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/jest-dom": "^6.6.3",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.1",
		"@types/react": "^19.2.7",
		"@types/react-dom": "^19.2.3",
		"babel-jest": "^29.7.0",
		"babel-plugin-transform-vite-meta-env": "^1.0.3",
		"electron": "^32.2.0",
		"husky": "^9.1.7",
		"jest": "^29.5.0",
		"jest-environment-jsdom": "^30.3.0",
		"jsdom": "^26.0.0",
		"prisma": "6.19.3",
		"typescript": "^6.0.3",
		"vite": "^6.3.2",
		"wait-on": "^8.0.1"
	},
	"allowScripts": {
		"@google/genai@2.7.0": true,
		"@prisma/client@6.19.3": true,
		"@prisma/engines@6.19.3": true,
		"electron@32.3.3": true,
		"esbuild@0.25.12": true,
		"opencode-ai@1.15.12": true,
		"prisma@6.19.3": true,
		"protobufjs@7.6.1": true
	},
	"optionalDependencies": {
		"dev": "^0.1.5"
	}
}
