{
	"name": "gartexhub",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"lint": "biome check .",
		"format": "biome format --write .",
		"check": "biome check --write .",
		"preview": "vite preview",
		"server": "node server/server.js",
		"logs": "node server/tui/index.js",
		"dev:full": "concurrently \"npm run server\" \"npm run dev -- --host 0.0.0.0\"",
		"start:prod": "node server/server.js",
		"app": "npm run build && concurrently -k -s first \"npm run server\" \"wait-on tcp:4000 dist/index.html && electron electron/main.cjs\"",
		"docs:generate": "node scripts/generate-docs-index.mjs && node scripts/render-docs.mjs",
		"convertMdDocsToDocx": "node scripts/convertMdDocsToDocx.mjs",
		"install:pypandoc": "where pandoc || choco install pandoc -y",
		"db:generate": "prisma generate",
		"db:migrate:dev": "prisma migrate dev",
		"db:studio": "prisma studio",
		"db:migrate:prod": "prisma migrate deploy",
		"db:backfill:org-operations": "node scripts/db/backfill-org-operations-policies.mjs",
		"ai:eval": "node scripts/run-ai-extraction-regression.mjs",
		"test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
		"test:unit": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --testPathPattern=tests/unit",
		"test:e2e": "playwright test",
		"ci:reindex": "node scripts/ci/reindex-opensearch.mjs",
		"diagnose": "node scripts/diagnose.mjs",
		"ci:smoke": "node scripts/ci/smoke-search.mjs",
		"ci:full": "npm run ci:reindex && npm test && npm run ci:smoke",
		"worker:lead-reminders": "node server/workers/leadRemindersWorker.js",
		"prepare": "husky install || true",
		"dev:services": "docker compose up -d ollama qdrant",
		"dev:models": "bash scripts/pull-ollama-models.sh",
		"dev:all": "npm run dev:services && npm run dev:models && npm run dev:full",
		"local": "docker compose up -d ollama qdrant && bash scripts/pull-ollama-models.sh && concurrently \"npm run server\" \"npm run dev -- --host 0.0.0.0\""
	},
	"dependencies": {
		"@fortawesome/fontawesome-free": "^6.7.2",
		"@google/genai": "^2.3.0",
		"@opencode-ai/sdk": "^1.15.3",
		"@opensearch-project/opensearch": "^2.13.0",
		"@prisma/client": "6.19.3",
		"@qdrant/qdrant-js": "^1.18.0",
		"@reduxjs/toolkit": "^2.12.0",
