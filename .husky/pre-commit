#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

# NOTE: this hook intentionally does NOT run `biome check --write .`.
# A repo-wide auto-format rewrites hundreds of unrelated files (it touched 602
# on the previous run) and then `git add -u` stages all of that churn. Only
# lint the files that are actually being committed.

echo "Running pre-commit checks..."

echo "1. Running Biome check on staged files..."
BIOME_FILES=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(js|jsx|mjs|cjs|ts|tsx|json|css)$' | tr '\n' ' ')
if [ -z "$BIOME_FILES" ]; then
  echo "No staged files matching the Biome extension filter; skipping Biome."
else
  # shellcheck disable=SC2086
  npx biome check --no-errors-on-unmatched --files-ignore-unknown=true $BIOME_FILES
  if [ $? -ne 0 ]; then
    echo "Biome check failed!"
    exit 1
  fi
fi

echo "2. Running Tests..."
# npm's OWN exit status is the gate.
#
# The previous form was `npm test 2>&1 | grep -E "(PASS|FAIL|Tests:)"` followed
# by `if [ $? -ne 0 ]`, which reads GREP's exit status, not npm's. A red suite
# still prints FAIL and a Tests: line, so grep exits 0 and the gate passed: the
# one automated defence against "shipped green while asserting nothing" could
# not fail.
#
# `set -o pipefail` is not the fix here: husky runs this file with `sh -e`, and
# /bin/sh is dash on Debian, where pipefail does not exist. Capturing npm's
# exit code is portable and reads the right status.
#
# The output is captured rather than piped so a failure can print the whole
# suite output, not just the grep summary.
TEST_STATUS=0
TEST_OUTPUT=$(npm test 2>&1) || TEST_STATUS=$?
echo "$TEST_OUTPUT" | grep -E "(PASS|FAIL|Tests:)" || true
if [ "$TEST_STATUS" -ne 0 ]; then
  echo "Tests failed!"
  echo "$TEST_OUTPUT"
  exit 1
fi

echo "3. Running Build..."
npm run build
if [ $? -ne 0 ]; then
  echo "Build failed!"
  exit 1
fi

echo "Pre-commit checks passed!"