#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

# NOTE: this hook intentionally does NOT run `biome check --write .`.
# A repo-wide auto-format rewrites hundreds of unrelated files (it touched 602
# on the previous run) and then `git add -u` stages all of that churn. Only
# lint the files that are actually being committed.

echo "Running pre-commit checks..."

echo "1. Running Biome check on staged files..."
BIOME_FILES=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(js|jsx|mjs|cjs|ts|tsx|json|css)$' | tr '\n' ' ')
if [ -z "$BIOME_FILES" ]; then
  echo "No staged files matching the Biome extension filter; skipping Biome."
else
  # shellcheck disable=SC2086
  npx biome check --no-errors-on-unmatched --files-ignore-unknown=true $BIOME_FILES
  if [ $? -ne 0 ]; then
    echo "Biome check failed!"
    exit 1
  fi
fi

echo "2. Running Tests..."
npm test 2>&1 | grep -E "(PASS|FAIL|Tests:)"
if [ $? -ne 0 ]; then
  echo "Tests failed!"
  exit 1
fi

echo "3. Running Build..."
npm run build
if [ $? -ne 0 ]; then
  echo "Build failed!"
  exit 1
fi

echo "Pre-commit checks passed!"