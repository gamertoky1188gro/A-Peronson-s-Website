#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

echo "Running pre-commit checks..."

echo "1. Running Biome check (lint + format)..."
npx biome check --write --no-errors-on-unmatched .
if [ $? -ne 0 ]; then
  echo "Biome check failed!"
  exit 1
fi

# Stage any files Biome auto-fixed
git add -u

echo "2. Running Tests..."
npm test 2>&1 | grep -E "(PASS|FAIL|Tests:)"
if [ $? -ne 0 ]; then
  echo "Tests failed!"
  exit 1
fi

echo "3. Running Build..."
npm run build
if [ $? -ne 0 ]; then
  echo "Build failed!"
  exit 1
fi

echo "4. Checking for changes..."
git diff HEAD --stat

echo "Pre-commit checks passed!"