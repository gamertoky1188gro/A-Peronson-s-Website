# =============================================================================
# GarTexHub — environment reference
# Copy to .env before first run:  cp .env.example .env
# NEVER commit a real .env file. All secrets below are placeholders.
# =============================================================================

# -----------------------------------------------------------------------------
# Required (boot-fatal) — the server refuses to start without these
# Validated in server/server.js (REQUIRED_ENV_VARS).
# -----------------------------------------------------------------------------
# PostgreSQL connection string (Prisma).
DATABASE_URL=postgresql://user:password@localhost:5432/gartexhub?schema=public
# HMAC secret for access tokens (12h, claims: id, role, email, org_owner_id, member_id, auth_via_passkey).
# Use a long random string, e.g. `openssl rand -hex 32`.
JWT_SECRET=changeme-to-a-long-random-string

# -----------------------------------------------------------------------------
# JWT
# -----------------------------------------------------------------------------
JWT_ISSUER=gartexhub-api
JWT_AUDIENCE=gartexhub-client

# -----------------------------------------------------------------------------
# Server core
# -----------------------------------------------------------------------------
# API port (default 4000)
PORT=4000
# development | production | test
NODE_ENV=development
# Dev-only: boot without a live DB after ~30s retry (feature-limited)
# ALLOW_DB_OFFLINE=1
# Serve the built frontend from dist/ from the API (production mode)
# SERVE_DIST=1
# Public base URL used in links, emails and callbacks
APP_BASE_URL=http://localhost:4000
# Global request timeout
# REQUEST_TIMEOUT_MS=30000
# Switch CRM queries to the SQL-backed store (default: true when unset)
# USE_SQL_CRM=true
# CRM_SQL_ENABLED=true

# -----------------------------------------------------------------------------
# Recommended
# -----------------------------------------------------------------------------
# Queue/rate-limit broker (falls back to in-memory with degraded guarantees)
# REDIS_URL=redis://localhost:6379
# Comma-separated origins allowed for /ws (default: http://localhost:5173,http://localhost:4000)
ALLOWED_WS_ORIGINS=http://localhost:5173,http://localhost:4000
# Default admin account email for local dev
# ADMIN_TEST_EMAIL=owner@example.com
# Interval for the event-quality reporter
# EVENT_QUALITY_REPORT_INTERVAL_MS=600000
# Interval for partner join-request reminders
# JOIN_REQUEST_REMINDER_INTERVAL_MS=1800000
# Interval for lead follow-up reminders
# LEAD_REMINDER_INTERVAL_MS=300000
# Days after deal completion before auto-rating
# AUTO_RATING_DAYS=7
# Tolerance for unknown event types in analytics
# EVENTS_ALLOW_UNKNOWN_TYPES=false

# -----------------------------------------------------------------------------
# Owner-only admin access (optional)
# If either of these lists are set, ONLY the listed account(s) can access /api/admin routes
# (even if other users have the admin/owner role). Comma-separated values.
# ADMIN_OWNER_EMAILS=owner@example.com
# ADMIN_OWNER_IDS=your-owner-user-id

# -----------------------------------------------------------------------------
# Admin security
# -----------------------------------------------------------------------------
# CIDR/exact IP allowlist for admin actions
# ADMIN_IP_ALLOWLIST=127.0.0.1,192.168.1.0/24
# x-device-id allowlist (device-factor gate)
# ADMIN_DEVICE_ALLOWLIST=device-abc-123
# Remote-exec gate (server-admin actions)
# ADMIN_EXEC_ENABLED=false
# ADMIN_EXEC_ALLOWLIST=
# ADMIN_EXEC_ALLOW_ANY=false
# ADMIN_EXEC_TIMEOUT_MS=10000
# Step-up MFA
# ADMIN_MFA_REQUIRED=false
# ADMIN_MFA_METHODS=passkey,mfa_code
# ADMIN_MFA_CODE=
# Step-up headers x-admin-stepup / x-admin-stepup-at window (default 10 min)
# ADMIN_STEPUP_CODE=
# ADMIN_STEPUP_MAX_MINUTES=10
# Dual-approval codes for export actions (admins exempt)
# ADMIN_EXPORT_CODE_PRIMARY=changeme
# ADMIN_EXPORT_CODE_SECONDARY=changeme

# -----------------------------------------------------------------------------
# AI configuration
# -----------------------------------------------------------------------------
# Enable/disable AI features (default: true)
AI_ENABLED=true
# Primary AI provider: "ollama", "openrouter", "gemini", "huggingface", "opencode", or "none"
AI_PRIMARY_PROVIDER=ollama
# Fallback AI provider: "ollama", "openrouter", "gemini", "huggingface", "opencode", or "none"
AI_FALLBACK_PROVIDER=openrouter
# AI thresholds
AI_HANDOFF_THRESHOLD=0.65
AI_HALLUCINATION_THRESHOLD=0.7
# Enable/disable AI Haram content moderation (default: true)
AI_HARAM_ANALYTICS_ENABLED=true
# YOLO venv + detection paths
# HARAM_DETECTION_DIR=PythonAi/HaramDetection
# VENV_DIR=PythonAi/venv
# Semantic search on/off
# AI_SEARCH_ENABLED=true

# Ollama / Local LLM configuration
# Host for local Ollama instance (default: 127.0.0.1)
OLLAMA_HOST=127.0.0.1
# Port for local Ollama instance (default: 11434)
OLLAMA_PORT=11434
# Local LLM model to use (default: llama3)
OLLAMA_MODEL=llama3
# Timeout for LLM requests in ms (default: 45000)
OLLAMA_TIMEOUT_MS=45000

# Optional: Direct override for full endpoints
# OLLAMA_CHAT_ENDPOINT=http://127.0.0.1:11434/v1/chat/completions
# OLLAMA_COMPLETION_ENDPOINT=http://127.0.0.1:11434/completion

# OpenRouter configuration (cloud fallback)
# Get your API key from https://openrouter.ai/settings
OPENROUTER_API_KEY=
# Model to use (default: meta-llama/llama-3.1-8b-instruct)
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct
# Timeout for OpenRouter requests in ms (default: 60000)
OPENROUTER_TIMEOUT_MS=60000
# Referer for OpenRouter (optional)
OPENROUTER_REFERER=https://yourdomain.com
# App title for OpenRouter (optional)
OPENROUTER_APP_TITLE=YourAppName

# Gemini provider
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# GEMINI_TIMEOUT_MS=30000

# OpenCode-backed assistant answers (embedded OpenCode server)
# OPENCODE_ENABLED=true
# OPENCODE_BASE_URL=
# OPENCODE_PROVIDER_ID=
# OPENCODE_MODEL_ID=
# OPENCODE_TIMEOUT_MS=60000

# -----------------------------------------------------------------------------
# Vector / search
# -----------------------------------------------------------------------------
# Qdrant Vector Search
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=

# Embedding Service (BGE-M3) — supports: ollama, huggingface, opencode
EMBEDDING_PROVIDER=ollama
EMBEDDING_URL=http://127.0.0.1:11434
EMBEDDING_API_KEY=
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMENSION=1024

# Reranker Service (BGE-Reranker) — supports: ollama, huggingface
RERANKER_PROVIDER=ollama
RERANKER_URL=http://127.0.0.1:11434
RERANKER_API_KEY=
RERANKER_MODEL=bge-reranker-v2-m3

# OpenSearch (products + requirements indexes, suggestions, spelling)
# OPENSEARCH_URL=http://localhost:9200
# OPENSEARCH_USERNAME=admin
# OPENSEARCH_PASSWORD=changeme

# -----------------------------------------------------------------------------
# E-sign provider configuration
# -----------------------------------------------------------------------------
# Set ESIGN_PROVIDER_TYPE to 'http' to enable the HTTP provider adapter.
ESIGN_PROVIDER_TYPE=http
# Base URL for the e-sign provider adapter/service. The adapter should expose
# a POST /signing_sessions endpoint that returns { signing_url, session_id }.
ESIGN_PROVIDER_URL=https://your-esign-adapter.example
# API key or bearer token to call the provider (optional)
ESIGN_PROVIDER_API_KEY=changeme
# Where the provider should return users after signing (optional)
ESIGN_RETURN_URL=https://your-app.example/contracts/{contractId}/signed

# Example: Dropbox Sign (HelloSign) integration
# Set ESIGN_PROVIDER_TYPE to 'dropbox_sign' and configure the API key and URL
# ESIGN_PROVIDER_TYPE=dropbox_sign
# ESIGN_PROVIDER_URL=https://api.hellosign.com/v3
# ESIGN_DROPBOX_SIGN_API_KEY=changeme

# Webhook secret used to validate provider callbacks (kept for reference)
ESIGN_WEBHOOK_SECRET=changeme
# Webhook retry settings
# Interval in ms for retry worker to scan and retry failed callbacks
ESIGN_WEBHOOK_RETRY_INTERVAL_MS=60000
# Maximum retry attempts before dropping an event
ESIGN_WEBHOOK_MAX_ATTEMPTS=5
# Base backoff in ms (exponential backoff multiplier will be applied)
ESIGN_WEBHOOK_RETRY_BACKOFF_MS=10000
# Nonce dedupe retention / callback tolerance
# ESIGN_WEBHOOK_NONCE_RETENTION_MS=86400000
# ESIGN_WEBHOOK_TOLERANCE_SECONDS=300

# -----------------------------------------------------------------------------
# Email / SMS / notifications
# -----------------------------------------------------------------------------
# SMTP transport
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false
# SMTP_FROM=no-reply@example.com
# Gmail OAuth transport
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_REFRESH_TOKEN=
# GMAIL_SENDER=
# SMS transport
# SMS_PROVIDER=
# SMS_API_KEY=
# Ops/notify channel
# SLACK_WEBHOOK_URL=

# -----------------------------------------------------------------------------
# Storage / banking
# -----------------------------------------------------------------------------
# S3-compatible storage
# S3_BUCKET=
# S3_ACCESS_KEY=
# Google Cloud Storage
# GCS_BUCKET=
# GCS_ACCESS_KEY=
# DigitalOcean Spaces
# SPACES_BUCKET=
# SPACES_ACCESS_KEY=
# Banking reference lookups
# BANK_API_BASE=
# BANK_API_KEY=

# -----------------------------------------------------------------------------
# Feed / anti-spam
# -----------------------------------------------------------------------------
# Boost decay/multiplier/window/eligibility
# FEED_BOOST_DECAY_DAYS=60
# FEED_BOOST_MULTIPLIER=
# FEED_BOOST_WINDOW_HOURS=
# FEED_BOOST_MIN_ACCOUNT_AGE_DAYS=
# Text spam gates
# FEED_SPAM_KEYWORD_LIMIT=3
# FEED_SPAM_DUPLICATE_RATIO_LIMIT=0.8
# FEED_SPAM_MIN_WORD_VARIETY=0.3
# Rapid-post abuse throttle
# FEED_ABUSE_RAPID_MAX_POSTS=5
# FEED_ABUSE_RAPID_WINDOW_MINUTES=10

# -----------------------------------------------------------------------------
# Realtime / WebRTC / passkeys
# -----------------------------------------------------------------------------
# STUN servers
# STUN_URLS=stun:stun.l.google.com:19302
# TURN relay (shared-secret TTL rotation)
# TURN_URLS=turn:turn.example.com:3478
# TURN_USERNAME=
# TURN_CREDENTIAL=
# TURN_SHARED_SECRET=
# TURN_TTL_SECONDS=3600
# WebAuthn relying party (passkey login)
# PASSKEY_RP_ID=localhost
# PASSKEY_RP_NAME=GarTexHub

# -----------------------------------------------------------------------------
# Monitoring / syslog
# -----------------------------------------------------------------------------
# UDP/TLS syslog forwarder (self-signed cert generation)
# SYSLOG_PORT=6514
# SYSLOG_CERT_DIR=
# SYSLOG_CERT_SUBJ=
# Intrusion-detection feed integration
# IDS_API_URL=
# IDS_LOG_PATH=
# IDS_SOURCE=

# -----------------------------------------------------------------------------
# Legacy / dev infrastructure (reserved)
# -----------------------------------------------------------------------------
# RADIUS_HOST=
# RADIUS_SECRET=
# TACACS_HOST=
# TACACS_SECRET=
# NETFLOW_API=
# NETFLOW_COLLECTOR=
# WIFI_CONTROLLER_API=
# PHPMYADMIN_URL=
# REGISTRAR_PROVIDER=
# REGISTRAR_API_TOKEN=

# -----------------------------------------------------------------------------
# Frontend (VITE_*) — inlined by Vite at build time; prefix MUST be VITE_
# -----------------------------------------------------------------------------
# API base URL (production build)
# VITE_API_URL=/api
# WebSocket URL
# VITE_WS_URL=ws://localhost:4000
# ICE server list for WebRTC calls
# VITE_ICE_SERVERS=[]
# Vite dev-server proxy target
# VITE_API_PROXY=http://localhost:4000
